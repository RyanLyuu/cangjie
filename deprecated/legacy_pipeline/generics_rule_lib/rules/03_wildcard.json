{
  "category": "wildcard",
  "description": "通配符转换规则：Java 的通配符 ? extends/? super 是 Java 泛型的核心难点。仓颉没有通配符，有三种策略：(1) 提升为泛型方法参数 (2) 使用类型投影 ~T (3) 使用 out/in 声明处型变。",
  "rules": [
    {
      "id": "C12",
      "subcategory": "unbounded_wildcard",
      "name": "无界通配符 <?>",
      "java_ast_pattern": {
        "node_type": "WildcardType",
        "bound_type": "unbounded"
      },
      "java_regex_fallback": "(\\w+)<\\s*\\?\\s*>",
      "cangjie_template": "将整个方法提升为泛型方法，用类型参数 T 代替 ?",
      "transforms": [
        { "from": "<?>作为参数类型", "to": "<T>作为方法类型参数", "scope": "method_signature", "comment": "未约束的通配符意味着接受任意类型，等价于引入新的类型参数" }
      ],
      "constraints": {
        "cangjie_semantics": "仓颉没有通配符，必须将包含<?>的方法整体提升为泛型方法",
        "requires": [],
        "conflicts": [],
        "action": "将包含无界通配符的方法转为泛型方法"
      },
      "priority": 8,
      "example": {
        "java": "void print(List<?> list)",
        "cangjie": "func print<T>(list: List<T>)",
        "note": "引入类型参数 T 替代 ?"
      },
      "validation_probes": ["cjpm build 是否通过", "调用处是否需要指定类型参数"]
    },
    {
      "id": "C13",
      "subcategory": "upper_bounded_wildcard",
      "name": "上界通配符 <? extends>",
      "java_ast_pattern": {
        "node_type": "WildcardType",
        "bound_type": "extends"
      },
      "java_regex_fallback": "(\\w+)<\\s*\\?\\s+extends\\s+(\\w+)\\s*>",
      "cangjie_template": "将方法提升为泛型方法，<? extends $2> → <T> where T <: $2",
      "transforms": [
        { "from": "? extends UpperBound", "to": "类型参数 T + where T <: UpperBound", "scope": "parameter" }
      ],
      "constraints": {
        "cangjie_semantics": "仓颉无通配符，上界通配符映射为泛型参数 + 约束",
        "requires": ["C07"],
        "conflicts": [],
        "action": "提升为泛型方法并添加上界约束"
      },
      "priority": 8,
      "example": {
        "java": "double sum(List<? extends Number> list)",
        "cangjie": "func sum<T>(list: List<T>): Float64 where T <: Number",
        "note": "引入 T 并约束 T <: Number"
      },
      "validation_probes": ["cjpm build 是否通过"]
    },
    {
      "id": "C14",
      "subcategory": "lower_bounded_wildcard",
      "name": "下界通配符 <? super>",
      "java_ast_pattern": {
        "node_type": "WildcardType",
        "bound_type": "super"
      },
      "java_regex_fallback": "(\\w+)<\\s*\\?\\s+super\\s+(\\w+)\\s*>",
      "cangjie_template": "$1<~$2>",
      "transforms": [
        { "from": "? super LowerBound", "to": "~LowerBound 逆变投影", "scope": "type_argument" }
      ],
      "constraints": {
        "cangjie_semantics": "仓颉使用 ~ 表示逆变投影，List<~Integer> 表示可以存放 Integer 及其父类型",
        "requires": [],
        "conflicts": [],
        "note": "使用类型投影 ~ 表达逆变，不能直接转为泛型函数；读取时元素类型为下界的某个父类型"
      },
      "priority": 8,
      "example": {
        "java": "void addNumbers(List<? super Integer> list)",
        "cangjie": "func addNumbers(list: List<~Integer>)",
        "note": "~ 表示逆变投影"
      },
      "validation_probes": ["cjpm build 是否通过", "~投影只读操作受限制"]
    },
    {
      "id": "C15",
      "subcategory": "nested_wildcard",
      "name": "嵌套通配符",
      "java_ast_pattern": {
        "node_type": "WildcardType",
        "bound_type": "nested"
      },
      "java_regex_fallback": "(\\w+)<\\s*(\\w+)<\\s*\\?\\s*>\\s*>",
      "cangjie_template": "将最内层 ? 提升为类型参数，转为 $1<$2<T>>，并提升外层方法为泛型",
      "transforms": [
        { "from": "嵌套无界通配符", "to": "递归提升为泛型参数", "scope": "nested_type" }
      ],
      "constraints": {
        "cangjie_semantics": "嵌套通配符需要递归处理，将内层通配符提升为类型参数",
        "requires": ["C12"],
        "conflicts": [],
        "action": "类似无界通配符处理，引入类型参数 T"
      },
      "priority": 7,
      "example": {
        "java": "void process(List<List<?>> nested)",
        "cangjie": "func process<T>(nested: List<List<T>>)",
        "note": "内层 ? 提升为 T"
      },
      "validation_probes": ["cjpm build 是否通过"]
    },
    {
      "id": "C16",
      "subcategory": "wildcard_capture",
      "name": "通配符捕获辅助方法消除",
      "java_ast_pattern": {
        "node_type": "MethodDeclaration",
        "constraint_type": "wildcard_capture_helper"
      },
      "java_regex_fallback": "private\\s+<\\s*([A-Z]\\w*)\\s*>\\s+\\w+\\s+\\w+\\s*\\([^)]*List<\\1>[^)]*\\)\\s*\\{",
      "cangjie_template": "合并为单个泛型函数",
      "transforms": [
        { "from": "public方法+private泛型辅助方法", "to": "单个泛型方法", "scope": "method_pair" }
      ],
      "constraints": {
        "cangjie_semantics": "Java 的通配符捕获模式在仓颉中不需要，可直接合并为泛型方法",
        "requires": [],
        "conflicts": [],
        "action": "将 Java 中通配符捕获的两个方法合并为一个仓颉泛型函数"
      },
      "priority": 6,
      "example": {
        "java": "void swap(List<?> list, int i, int j) { swapHelper(list, i, j); }\nprivate <T> void swapHelper(List<T> list, int i, int j) { T temp = list.get(i); ... }",
        "cangjie": "func swap<T>(list: List<T>, i: Int64, j: Int64) { let temp = list[i]; ... }",
        "note": "Java 的通配符捕获辅助方法在仓颉中直接合并"
      },
      "validation_probes": ["cjpm build 是否通过", "合并后是否保留原始语义"]
    },
    {
      "id": "C17",
      "subcategory": "return_wildcard",
      "name": "返回类型中的通配符",
      "java_ast_pattern": {
        "node_type": "MethodDeclaration",
        "constraint_type": "return_wildcard"
      },
      "java_regex_fallback": "\\w+<\\s*\\?(?:\\s+extends\\s+\\w+)?\\s*>\\s+\\w+\\s*\\(",
      "cangjie_template": "将方法提升为泛型方法，返回类型中的通配符替换为类型参数",
      "transforms": [
        { "from": "返回类型通配符", "to": "泛型方法 + 类型参数返回", "scope": "return_type" }
      ],
      "constraints": {
        "cangjie_semantics": "返回类型中的通配符需要提升为方法类型参数",
        "requires": ["C12", "C13"],
        "conflicts": []
      },
      "priority": 7,
      "example": {
        "java": "List<?> getList()",
        "cangjie": "func getList<T>(): List<T>",
        "note": "返回值通配符也需提升为泛型参数"
      },
      "validation_probes": ["cjpm build 是否通过", "调用处类型推断是否正确"]
    }
  ]
}