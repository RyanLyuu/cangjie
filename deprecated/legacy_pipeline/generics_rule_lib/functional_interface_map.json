      "java_params": ["T"],
      "cangjie_params": ["T"],
      "cangjie_return": "Bool",
      "notes": "单参返回布尔值"
    },
    "BiFunction": {
      "cangjie": "(T, U) -> R",
      "type_params": 3,
      "java_params": ["T", "U", "R"],
      "cangjie_params": ["T", "U"],
      "cangjie_return": "R",
      "notes": "双参有返回值"
    },
    "BiConsumer": {
      "cangjie": "(T, U) -> Unit",
