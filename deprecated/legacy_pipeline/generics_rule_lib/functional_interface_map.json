    },
    "BinaryOperator": {
      "cangjie": "(T, T) -> T",
      "type_params": 1,
      "java_params": ["T"],
      "cangjie_params": ["T", "T"],
      "cangjie_return": "T",
      "notes": "双参同类型返回，BiFunction<T,T,T>的特化"
