    },
    "LongConsumer": {
      "cangjie": "(Int64) -> Unit",
      "type_params": 0,
      "java_params": [],
      "cangjie_params": ["Int64"],
      "cangjie_return": "Unit",
      "notes": "Long 消费特化"
    },
    "LongSupplier": {
      "cangjie": "() -> Int64",
      "type_params": 0,
      "java_params": [],
      "cangjie_params": [],
      "cangjie_return": "Int64",
