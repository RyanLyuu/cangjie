    },
    "DoubleSupplier": {
      "cangjie": "() -> Float64",
      "type_params": 0,
      "java_params": [],
      "cangjie_params": [],
      "cangjie_return": "Float64",
      "notes": "Double 供应特化"
    },
    "DoublePredicate": {
      "cangjie": "(Float64) -> Bool",
      "type_params": 0,
      "java_params": [],
      "cangjie_params": ["Float64"],
      "cangjie_return": "Bool",
      "notes": "Double 断言特化"
    },
    "ToDoubleFunction": {
      "cangjie": "(T) -> Float64",
      "type_params": 1,
      "java_params": ["T"],
      "cangjie_params": ["T"],
