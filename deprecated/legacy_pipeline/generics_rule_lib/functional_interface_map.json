{
  "version": "1.0",
  "description": "Java 函数式接口到仓颉函数类型的映射。仓颉使用函数类型语法 (T) -> R 而非接口类型。Java 的 SAM 接口在仓颉中应映射为函数类型。",
  "mappings": {
    "Runnable": {
      "cangjie": "() -> Unit",
      "type_params": 0,
      "java_params": [],
      "cangjie_params": [],
      "cangjie_return": "Unit",
      "notes": "无参无返回值"
    },
    "Callable": {
      "cangjie": "() -> V",
      "type_params": 1,
      "java_params": ["V"],
      "cangjie_params": [],
      "cangjie_return": "V",
      "notes": "无参有返回值，仓颉用函数类型表示"
    },
    "Function": {
      "cangjie": "(T) -> R",
      "type_params": 2,
      "java_params": ["T", "R"],
      "cangjie_params": ["T"],
      "cangjie_return": "R",
      "notes": "单参有返回值，最常用的函数式接口"
    },
