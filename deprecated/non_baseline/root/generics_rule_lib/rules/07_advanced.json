{
  "category": "advanced",
  "description": "递归边界与高级泛型模式：涵盖递归泛型约束、Enum 泛型、自引用泛型、泛型构造器等高级场景。",
  "rules": [
    {
      "id": "C29",
      "subcategory": "recursive_bound",
      "name": "递归泛型边界",
      "java_ast_pattern": {
        "node_type": "TypeParameter",
        "constraint_type": "recursive"
      },
      "java_regex_fallback": "(\\w+)\\s+extends\\s+Comparable<\\s*\\1\\s*>",
      "cangjie_template": "where $1 <: Comparable<$1>",
      "transforms": [],
      "constraints": {
        "cangjie_semantics": "仓颉支持递归泛型约束，语法与 Java 一致",
        "requires": ["C09"],
        "conflicts": []
      },
      "priority": 8,
      "example": {
        "java": "class Sorted<T extends Comparable<T>>",
        "cangjie": "class Sorted<T> where T <: Comparable<T>",
        "note": "递归约束直迁"
      },
      "validation_probes": ["cjpm build 是否通过"]
    },
    {
      "id": "C30",
      "subcategory": "enum_generic",
      "name": "Enum 泛型参数",
      "java_ast_pattern": {
        "node_type": "EnumDeclaration",
        "has_type_parameters": true
      },
      "java_regex_fallback": "enum\\s+(\\w+)\\s*<\\s*[^>]+\\s*>",
      "cangjie_template": "// 仓颉 enum 不支持泛型参数，请改为普通类或使用枚举变体模拟",
      "transforms": [],
      "constraints": {
        "cangjie_semantics": "仓颉的 enum 不支持泛型参数，与 Java 的 Enum<E extends Enum<E>> 完全不同",
        "requires": [],
        "conflicts": [],
        "action": "标记为需要重构：删除泛型参数，或使用枚举变体，或使用普通 class 模拟"
      },
      "priority": 4,
      "example": {
        "java": "enum MyEnum { A, B }",
        "cangjie": "enum MyEnum { A | B }  // 无泛型，若需要类似 Enum<E> 行为则需自定义类",
        "note": "仓颉 enum 是值类型，不支持泛型参数"
      },
      "validation_probes": ["cjpm build 是否通过", "确认 enum 无泛型参数"]
    },
    {
      "id": "C31",
      "subcategory": "self_referential",
      "name": "自引用泛型",
      "java_ast_pattern": {
        "node_type": "ClassDeclaration",
        "constraint_type": "self_referential"
      },
      "java_regex_fallback": "class\\s+(\\w+)\\s*<\\s*([A-Z]\\w*)\\s+extends\\s+\\1<\\s*\\2\\s*>\\s*>",
      "cangjie_template": "class $1<$2> where $2 <: $1<$2>",
      "transforms": [],
      "constraints": {
        "cangjie_semantics": "仓颉支持自引用泛型约束，但需注意约束推导的循环依赖",
        "requires": [],
        "conflicts": []
      },
      "priority": 7,
      "example": {
        "java": "class Node<T extends Node<T>>",
        "cangjie": "class Node<T> where T <: Node<T>",
        "note": "自引用约束直迁，但需注意编译验证"
      },
      "validation_probes": ["cjpm build 是否通过", "检查循环约束是否合法"]
    },
    {
      "id": "C32",
      "subcategory": "generic_constructor",
      "name": "泛型构造器（Class<T> 参数）",
      "java_ast_pattern": {
        "node_type": "MethodDeclaration",
        "has_class_type_parameter": true
      },
      "java_regex_fallback": "<\\s*([A-Z]\\w*)\\s*>\\s+\\w+\\s+\\w+\\s*\\(.*Class<\\s*\\1\\s*>",
      "cangjie_template": "func $3<$1>(): $2  // 去掉 Class 参数",
      "transforms": [
        { "from": "Class<T> 参数", "to": "去除 Class 参数或替换为 GenericType<T>", "scope": "parameters" }
      ],
      "constraints": {
        "cangjie_semantics": "仓颉无 Class 对象；泛型构造器中的 Class<T> 参数需要移除或替换",
        "requires": ["C28"],
        "conflicts": [],
        "action": "移除 Class<T> 参数，或改为 GenericType<T>"
      },
      "priority": 5,
      "example": {
        "java": "<T> T create(Class<T> clazz)",
        "cangjie": "func create<T>(): T",
        "note": "去除 Class 参数，泛型信息由编译器保留"
      },
      "validation_probes": ["cjpm build 是否通过"]
    }
  ]
}